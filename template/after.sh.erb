ENV_FILE=".env"
if [[ -f "${ENV_FILE}" ]]; then
  set -a
  . "${ENV_FILE}"
  set +a
fi

BASE_OUT_DIR=${BASE_OUT_DIR:-/srv/scratch/${USER}/bioemu2_output}
RESULTS_URL_BASE=${RESULTS_URL_BASE:-/pun/sys/dashboard/files/fs}
if [[ -s run_dir.txt ]]; then
  RUN_DIR=$(<run_dir.txt)
else
  # Open OnDemand sources this file on the OOD host, where PBS_JOBID is not
  # defined, so the job number has to come from the session directory name
  # (the basic template stage-out names it after the PBS job). Fall back to
  # the job name and finally to a bare sanitized run name.
  SAFE_NAME=$(printf '%s' '<%= context.run_name.to_s.gsub("'", "") %>' | sed 's/[^A-Za-z0-9_-]/_/g')
  JOB_TAG="${PBS_JOBID:-}"
  JOB_TAG="${JOB_TAG%%.*}"
  [[ -n "${JOB_TAG}" ]] || JOB_TAG=$(basename "$(pwd -P)" | sed -n 's/.*_\([0-9][0-9]*\)$/\1/p')
  [[ -n "${JOB_TAG}" ]] || JOB_TAG=$(basename "$(pwd -P)")
  RUN_DIR="${SAFE_NAME}_${JOB_TAG}"
fi
OUT_DIR="${BASE_OUT_DIR}/${RUN_DIR}"
ln -sfn "${OUT_DIR}" results 2>/dev/null || true

export base_out_dir="${BASE_OUT_DIR}"
export results_url_base="${RESULTS_URL_BASE}"
export run_dir="${RUN_DIR}"
export user="${USER}"
export session_output_dir="$(pwd -P)"

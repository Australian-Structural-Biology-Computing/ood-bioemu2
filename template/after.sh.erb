ENV_FILE=".env"
if [[ -f "${ENV_FILE}" ]]; then
  set -a
  . "${ENV_FILE}"
  set +a
fi

BASE_OUT_DIR=${BASE_OUT_DIR:-/srv/scratch/${USER}/bioemu2_output}
RESULTS_URL_BASE=${RESULTS_URL_BASE:-/pun/sys/dashboard/files/fs}
if [[ -s run_dir.txt ]]; then
  RUN_DIR=$(<run_dir.txt)
else
  # run_dir.txt is written by the job as soon as its output directory exists,
  # so reaching here means it died before that. The live log then still names
  # the directory the run was about to use -- prefer it over guessing.
  SAFE_NAME=$(printf '%s' '<%= context.run_name.to_s.gsub("'", "") %>' | sed 's/[^A-Za-z0-9_-]/_/g')
  LOGGED_DIR=$(sed -n 's/^BioEmu2 output: //p' "$(pwd -P)/live_log.log" 2>/dev/null | tail -1)
  if [[ -n "${LOGGED_DIR}" ]]; then
    RUN_DIR=$(basename "${LOGGED_DIR}")
  else
    # Effectively unreachable: only a crash before the job's first echo lands
    # here. The session directory is named after a UUID, which cannot
    # reconstruct the job number, so this names the run without one.
    RUN_DIR="${SAFE_NAME}_$(basename "$(pwd -P)")"
  fi
fi
OUT_DIR="${BASE_OUT_DIR}/${RUN_DIR}"
ln -sfn "${OUT_DIR}" results 2>/dev/null || true

export base_out_dir="${BASE_OUT_DIR}"
export results_url_base="${RESULTS_URL_BASE}"
export run_dir="${RUN_DIR}"
export user="${USER}"
export session_output_dir="$(pwd -P)"

ENV_FILE=".env"
if [[ -f "${ENV_FILE}" ]]; then
  set -a
  . "${ENV_FILE}"
  set +a
fi

BASE_OUT_DIR=${BASE_OUT_DIR:-/srv/scratch/${USER}/bioemu2_output}
RESULTS_URL_BASE=${RESULTS_URL_BASE:-/pun/sys/dashboard/files/fs}
if [[ -s run_dir.txt ]]; then
  RUN_DIR=$(<run_dir.txt)
else
  # This script is sourced by the Open OnDemand wrapper immediately after it
  # LAUNCHES script.sh in the background -- not after the job completes (the
  # wrapper then writes connection.yml, which is what the completed view
  # reads). The job writes run_dir.txt within its first seconds, so wait
  # briefly for it rather than guessing.
  SAFE_NAME=$(printf '%s' '<%= context.run_name.to_s.gsub("'", "") %>' | sed 's/[^A-Za-z0-9_-]/_/g')
  for _ in $(seq 1 30); do
    [[ -s run_dir.txt ]] && break
    sleep 1
  done
  if [[ -s run_dir.txt ]]; then
    RUN_DIR=$(<run_dir.txt)
  else
    # The job died before publishing anything. PBS_JOBID IS defined here --
    # this whole wrapper is the PBS job -- and "${SAFE_NAME}_${PBS_JOBID%%.*}"
    # is exactly what script.sh would have computed, so it is the best
    # remaining guess (and correct for every failure after the first lines).
    LOGGED_DIR=$(sed -n 's/^BioEmu2 output: //p' "$(pwd -P)/live_log.log" 2>/dev/null | tail -1)
    if [[ -n "${LOGGED_DIR}" ]]; then
      RUN_DIR=$(basename "${LOGGED_DIR}")
    else
      RUN_DIR="${SAFE_NAME}_${PBS_JOBID%%.*}"
    fi
  fi
fi
OUT_DIR="${BASE_OUT_DIR}/${RUN_DIR}"
ln -sfn "${OUT_DIR}" results 2>/dev/null || true

export base_out_dir="${BASE_OUT_DIR}"
export results_url_base="${RESULTS_URL_BASE}"
export run_dir="${RUN_DIR}"
export user="${USER}"
export session_output_dir="$(pwd -P)"

<% require "shellwords" %>
#!/bin/bash
set -eEuo pipefail

ENV_FILE=".env"
if [[ -f "${ENV_FILE}" ]]; then
  set -a
  # shellcheck disable=SC1091
  . "${ENV_FILE}"
  set +a
fi

OOD_SESSION_DIR=$(pwd -P)
# The gate library is staged by Open OnDemand alongside this script (everything
# in the app's template/ directory is copied into the session), so source it
# relative to the script itself -- never via the repository layout, which does
# not exist inside the session (job 9805044 failed exactly there).
# shellcheck source=bioemu2_weights_lib.sh
. "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/bioemu2_weights_lib.sh"
BIOEMU2_IMAGE=${BIOEMU2_IMAGE:-/srv/scratch/sbf-pipelines/containers/ghcr.io-jscgh-proteinfold_colabfold-af3-preview-e9e8bd0.img}
BIOEMU2_WEIGHTS_ROOT=${BIOEMU2_WEIGHTS_ROOT:-/srv/scratch/sbf-pipelines/bioemu2/weights}
BIOEMU2_CACHE_ROOT=${BIOEMU2_CACHE_ROOT:-/srv/scratch/${USER}/.bioemu2/cache}
BIOEMU2_ALLOW_WEIGHT_DOWNLOAD=${BIOEMU2_ALLOW_WEIGHT_DOWNLOAD:-false}
BASE_OUT_DIR=${BASE_OUT_DIR:-/srv/scratch/${USER}/bioemu2_output}
BASE_WORK_DIR=${BASE_WORK_DIR:-/srv/scratch/${USER}/.bioemu2/work}
BASE_DEBUGDIR=${BASE_DEBUGDIR:-/srv/scratch/sbf/debug}
DEBUGGROUP=${DEBUGGROUP:-sbf}
METRICS_DIRECTORY=${METRICS_DIRECTORY:-/srv/scratch/sbf-pipelines/metrics}
ENABLE_METRICS=${ENABLE_METRICS:-true}
EXPECTED_RUNNER_SHA256=${EXPECTED_RUNNER_SHA256:-70a1102908353d75bccfccfa85738f72d053a8fa819554c5e02e6230cc9ba86b}

RUN_DIR=$(printf '%s' <%= Shellwords.escape(context.run_name.to_s) %> | sed 's/[^A-Za-z0-9_-]/_/g')
[[ -n "${RUN_DIR}" ]] || { echo "ERROR: run name is empty after sanitisation" >&2; exit 2; }
RUN_ID="${RUN_DIR}_${PBS_JOBID%%.*}"
OUT_DIR="${BASE_OUT_DIR}/${RUN_ID}"
WORK_DIR="${BASE_WORK_DIR}/${RUN_ID}"
DEBUGDIR="${BASE_DEBUGDIR}/bioemu2_${RUN_ID}"
LIVE_LOG="${OOD_SESSION_DIR}/live_log.log"
METRICS_FILE=""

mkdir -p "${OUT_DIR}" "${WORK_DIR}" "${BIOEMU2_CACHE_ROOT}"
# The shared weight root is bind-mounted read-only into the container, so a job
# can never write a downloaded blob into administrator-owned state. When
# downloads are permitted the job instead fetches into its own private copy of
# the exact file the gate expects: the upstream loader takes any *.bin.zst in
# --model_dir without re-checking the precision, so that copy must be named
# precisely.
DOWNLOAD_ARGS=()
if [[ "${BIOEMU2_ALLOW_WEIGHT_DOWNLOAD}" == "true" ]]; then
  DOWNLOAD_ARGS=(--allow-weight-download)
fi
# Location for the shared cross-job lock taken by scripts/setup_runtime.sh. It
# must sit somewhere ordinary users may create files: the shared weight root is
# administrator owned and bind-mounted read-only into jobs.
export BIOEMU2_LOCK_DIR="${BASE_WORK_DIR}"
exec > >(tee -a "${LIVE_LOG}")
exec 2>&1

collect_debug_files() {
  local status=$?
  trap - ERR
  # The diagnostics copy runs in a subshell. `set +e` inside a trap handler
  # LEAKS into the parent shell and silently disables errexit for the rest of
  # the script -- job 9800577 failed at the fold and still printed "completed
  # successfully", wrote run_dir.txt, and exited 0 because of exactly that.
  # The subshell contains the relaxed error handling; the parent keeps errexit
  # and exits with the failing command's status once the handler returns.
  (
    set +e
    echo "BioEmu2 failed (exit ${status}); copying bounded diagnostics to ${DEBUGDIR}"
    mkdir -p "${DEBUGDIR}"
    {
      echo "captured_at=$(date -u +%Y-%m-%dT%H:%M:%SZ)"
      echo "user=${USER}"
      echo "node=$(hostname)"
      echo "pbs_jobid=${PBS_JOBID:-}"
      echo "run_id=${RUN_ID}"
      echo "image=${BIOEMU2_IMAGE}"
      echo "exit_code=${status}"
    } > "${DEBUGDIR}/debug-metadata.txt"
    cp -f "${LIVE_LOG}" "${DEBUGDIR}/" 2>/dev/null || true
    rsync -a --no-perms --no-owner --no-group --max-size=50m "${OUT_DIR}/" "${DEBUGDIR}/output/" 2>/dev/null || true
    chgrp "${DEBUGGROUP}" -R "${DEBUGDIR}" 2>/dev/null || true
    find "${DEBUGDIR}" -type d -exec chmod 2770 {} + 2>/dev/null || true
    find "${DEBUGDIR}" -type f -exec chmod 660 {} + 2>/dev/null || true
  )
  return "${status}"
}
trap collect_debug_files ERR

finish() {
  local status=$?
  if [[ -n "${METRICS_FILE}" && -f "${METRICS_FILE}" ]]; then
    jq --arg finish_date "$(date -u +%Y-%m-%dT%H:%M:%SZ)" --argjson exit_status "${status}" \
      '. + {finish_date: $finish_date, exit_status: $exit_status}' \
      "${METRICS_FILE}" > "${METRICS_FILE}.tmp" && mv "${METRICS_FILE}.tmp" "${METRICS_FILE}" || true
  fi
  exit "${status}"
}
trap finish EXIT

[[ -r "${BIOEMU2_IMAGE}" ]] || { echo "ERROR: BioEmu2 container is unavailable: ${BIOEMU2_IMAGE}" >&2; exit 1; }
[[ -r "${OOD_SESSION_DIR}/run_alphafold.py" ]] || { echo "ERROR: pinned runner is missing" >&2; exit 1; }
printf '%s  %s\n' "${EXPECTED_RUNNER_SHA256}" "${OOD_SESSION_DIR}/run_alphafold.py" | sha256sum -c -
command -v apptainer >/dev/null || { echo "ERROR: apptainer is unavailable" >&2; exit 1; }
command -v nvidia-smi >/dev/null || { echo "ERROR: this job did not receive an NVIDIA GPU" >&2; exit 1; }
nvidia-smi --query-gpu=name,compute_cap,memory.total --format=csv,noheader

WEIGHTS_PRECISION=<%= Shellwords.escape(context.weights_precision.to_s) %>
# The shared root is read-only to jobs, so a job that is permitted to download
# fetches into its own private copy instead of writing into administrator-owned
# state. Declared next to the precision it is derived from.
WEIGHTS_GATE_ROOT="${BIOEMU2_WEIGHTS_ROOT}"
if [[ "${BIOEMU2_ALLOW_WEIGHT_DOWNLOAD}" == "true" ]]; then
  WEIGHTS_GATE_ROOT="${WORK_DIR}/weights"
fi
PROTEIN_INPUT=<%= Shellwords.escape(context.protein_input.to_s) %>
if [[ -f "${PROTEIN_INPUT}" ]]; then
  FASTA_INPUT="${WORK_DIR}/protein_input.fasta"
  cp -- "${PROTEIN_INPUT}" "${FASTA_INPUT}"
  chmod 600 "${FASTA_INPUT}"
  PROTEIN_INPUT="${FASTA_INPUT}"
  echo "Copied selected FASTA input into the run work directory."
fi
# A starting structure for trajectory propagation, same pattern as the FASTA:
# copied into the private work directory so the container can read it, however
# the session sandbox sees the original. It must be an mmCIF of this same
# input -- upstream validates that every input atom is present and fails the
# run otherwise.
PROPAGATE_FROM_INPUT=<%= Shellwords.escape(context.propagate_from.to_s) %>
if [[ -n "${PROPAGATE_FROM_INPUT}" ]]; then
  if [[ ! -f "${PROPAGATE_FROM_INPUT}" ]]; then
    echo "ERROR: the propagation start structure is not a readable file: ${PROPAGATE_FROM_INPUT}" >&2
    exit 1
  fi
  X0_INPUT="${WORK_DIR}/propagate_from.cif"
  cp -- "${PROPAGATE_FROM_INPUT}" "${X0_INPUT}"
  chmod 600 "${X0_INPUT}"
  PROPAGATE_FROM_INPUT="${X0_INPUT}"
  echo "Copied the propagation start structure into the run work directory."
fi
# alphafold3.model.weights.ensure_weights accepts ANY *.bin.zst already present
# in --model_dir and never re-checks the requested precision, so per-precision
# directories only isolate the representations if the gate demands the exact
# filename the published release uses and refuses a foreign blob outright.
# bioemu2_gate_weights is the same rule scripts/setup_runtime.sh applies, so the
# two callers cannot drift apart.
WEIGHTS_DIR="$(bioemu2_weights_dir "${BIOEMU2_WEIGHTS_ROOT}" "${WEIGHTS_PRECISION}")"
WEIGHTS_GATE_REASON=''
WEIGHTS_GATE_FILE=''
bioemu2_gate_weights "${WEIGHTS_GATE_ROOT}" "${WEIGHTS_PRECISION}" WEIGHTS_GATE_REASON WEIGHTS_GATE_FILE
# Capture the status on its own line. Immediately after `bioemu2_gate_weights` a
# word `case` would be parsed as a NEW pattern-clause header rather than the
# `in` of `case $? in`, which silently swallows the whole gate block and still
# passes `bash -n`.
WEIGHTS_GATE_STATUS=$?
if [[ "${WEIGHTS_GATE_STATUS}" == 1 && "${BIOEMU2_ALLOW_WEIGHT_DOWNLOAD}" == "true" ]]; then
  # Before spending an allocation on a multi-hundred-megabyte download, check
  # whether the administrator has already staged exactly what was asked for.
  # The job loads from its own private --model_dir either way, so a different
  # representation in the shared root cannot leak into this run; it is only
  # worth adopting when it is the one the user selected.
  SHARED_REASON=''
  SHARED_FILE=''
  if bioemu2_gate_weights "${BIOEMU2_WEIGHTS_ROOT}" "${WEIGHTS_PRECISION}" SHARED_REASON SHARED_FILE; then
    echo "BioEmu2 ${WEIGHTS_PRECISION} weights already installed by the administrator: ${SHARED_FILE}"
    WEIGHTS_GATE_ROOT="${BIOEMU2_WEIGHTS_ROOT}"
    WEIGHTS_GATE_FILE="${SHARED_FILE}"
    WEIGHTS_GATE_STATUS=0
  else
    echo "NOTE: shared root has no usable ${WEIGHTS_PRECISION} weights (${SHARED_REASON}); falling back to a private download."
  fi
fi
case "${WEIGHTS_GATE_STATUS}" in
  0) echo "BioEmu2 ${WEIGHTS_PRECISION} weights: ${WEIGHTS_GATE_FILE}";;
  1)
    if [[ "${BIOEMU2_ALLOW_WEIGHT_DOWNLOAD}" == "true" ]]; then
      # The precedence check above already proved the shared root is empty, so
      # only the private directory has to be usable. Gate it before committing
      # the allocation to a multi-hundred-megabyte download that would otherwise
      # fail at weight-load time, deep into the run.
      bioemu2_gate_weights "${WEIGHTS_GATE_ROOT}" "${WEIGHTS_PRECISION}" WEIGHTS_GATE_REASON WEIGHTS_GATE_FILE
      WEIGHTS_DOWNLOAD_STATUS=$?
      if [[ "${WEIGHTS_DOWNLOAD_STATUS}" != 1 ]]; then
        echo "ERROR: ${WEIGHTS_GATE_REASON}" >&2
        echo "Refusing to download into ${WEIGHTS_GATE_ROOT}." >&2
        exit 1
      fi
      echo "WARNING: ${WEIGHTS_GATE_REASON}; BIOEMU2_ALLOW_WEIGHT_DOWNLOAD is enabled, so this job will fetch them into ${WEIGHTS_GATE_ROOT}/${WEIGHTS_PRECISION} and pay the download time."
      if ! mkdir -p "$(bioemu2_weights_dir "${WEIGHTS_GATE_ROOT}" "${WEIGHTS_PRECISION}")"; then
        echo "ERROR: unable to create the private weight directory under ${WEIGHTS_GATE_ROOT}." >&2
        exit 1
      fi
    else
      echo "ERROR: ${WEIGHTS_GATE_REASON}." >&2
      echo "An administrator must run scripts/setup_runtime.sh ${WEIGHTS_PRECISION} once, on a node with internet access." >&2
      exit 1
    fi
    ;;
  *)
    # Unusable shared state: an unsupported representation, or a stray blob the
    # loader would silently pick up. A per-job download cannot fix either.
    echo "ERROR: ${WEIGHTS_GATE_REASON}" >&2
    echo "Refusing to run: the runner would load any *.bin.zst it finds in ${WEIGHTS_DIR}. Ask an administrator to re-run scripts/setup_runtime.sh ${WEIGHTS_PRECISION}." >&2
    exit 1
    ;;
esac

# Bind exactly the root the job reads from: the shared one read-only, or the
# job's own private copy when it is permitted to download into it. Computed here
# rather than before the gate because the precedence check may adopt the shared
# root for a job that arrived willing to download.
WEIGHTS_BIND="${WEIGHTS_GATE_ROOT}"
if [[ "${WEIGHTS_GATE_ROOT}" == "${BIOEMU2_WEIGHTS_ROOT}" ]]; then
  WEIGHTS_BIND_SUFFIX=":ro"
else
  WEIGHTS_BIND_SUFFIX=""
fi

if [[ "${ENABLE_METRICS}" == "true" ]]; then
  METRICS_LOG_PATH="${METRICS_DIRECTORY}/$(date +%Y/%m)"
  METRICS_FILE="${METRICS_LOG_PATH}/$(date -u +%Y-%m-%dT%H:%M:%SZ)-$(whoami)-${PBS_JOBID:-unknown}.json"
  if ! mkdir -p "${METRICS_LOG_PATH}" || ! jq -n \
    --arg date "$(date -u +%Y-%m-%dT%H:%M:%SZ)" --arg user "$(whoami)" --arg node "$(hostname)" \
    --arg pbs_jobid "${PBS_JOBID:-}" --arg app "bioemu2" --arg mode <%= Shellwords.escape(context.bioemu2_mode.to_s) %> \
    --arg sampler <%= Shellwords.escape(context.sampler.to_s) %> --arg outdir "${OUT_DIR}" --arg image "${BIOEMU2_IMAGE}" \
    '{date:$date,user:$user,node:$node,pbs_jobid:$pbs_jobid,app:$app,mode:$mode,sampler:$sampler,outdir:$outdir,image:$image}' > "${METRICS_FILE}"; then
    echo "WARNING: unable to write usage metrics; continuing." >&2
    METRICS_FILE=""
  fi
fi

ALLOW_DOWNLOAD=()
if [[ "${BIOEMU2_ALLOW_WEIGHT_DOWNLOAD}" == "true" ]]; then
  ALLOW_DOWNLOAD=("${DOWNLOAD_ARGS[@]}")
fi
export APPTAINER_CACHEDIR=${APPTAINER_CACHEDIR:-/srv/scratch/${USER}/.images}
export APPTAINER_TMPDIR=${APPTAINER_TMPDIR:-${TMPDIR:-/srv/scratch/${USER}/.images/tmp}}
mkdir -p "${APPTAINER_CACHEDIR}" "${APPTAINER_TMPDIR}"

echo "BioEmu2 output: ${OUT_DIR}"
echo "Runtime image: ${BIOEMU2_IMAGE}"
echo "ColabFold runner: 3.1.18 (vendored, checksum verified)"

apptainer exec --nv --cleanenv \
  --env HOME="${HOME}",TMPDIR="${TMPDIR:-/tmp}" \
  --bind "${OOD_SESSION_DIR}:${OOD_SESSION_DIR}:ro" \
  --bind "${OUT_DIR}:${OUT_DIR}" \
  --bind "${WORK_DIR}:${WORK_DIR}" \
  --bind "${BIOEMU2_CACHE_ROOT}:${BIOEMU2_CACHE_ROOT}" \
  --bind "${WEIGHTS_BIND}:${WEIGHTS_BIND}${WEIGHTS_BIND_SUFFIX}" \
  "${BIOEMU2_IMAGE}" \
  python "${OOD_SESSION_DIR}/bioemu2_colabfold.py" \
    --runner "${OOD_SESSION_DIR}/run_alphafold.py" \
    --output-dir "${OUT_DIR}" \
    --work-dir "${WORK_DIR}" \
    --cache-dir "${BIOEMU2_CACHE_ROOT}" \
    --weights-dir "${WEIGHTS_GATE_ROOT}" \
    --job-name <%= Shellwords.escape(context.run_name.to_s) %> \
    --protein "${PROTEIN_INPUT}" \
    --dna <%= Shellwords.escape(context.dna_input.to_s) %> \
    --rna <%= Shellwords.escape(context.rna_input.to_s) %> \
    --ligand-ccd <%= Shellwords.escape(context.ligand_ccd.to_s) %> \
    --ligand-smiles <%= Shellwords.escape(context.ligand_smiles.to_s) %> \
    --mode <%= Shellwords.escape(context.bioemu2_mode.to_s) %> \
    --msa-mode <%= Shellwords.escape(context.msa_mode.to_s) %> \
    --seeds <%= Shellwords.escape(context.seeds.to_s) %> \
    --num-recycles <%= Shellwords.escape(context.num_recycles.to_s) %> \
    --num-diffusion-samples <%= Shellwords.escape(context.num_diffusion_samples.to_s) %> \
    --sampler <%= Shellwords.escape(context.sampler.to_s) %> \
    --physicality <%= Shellwords.escape(context.physicality.to_s) %> \
    --propagate-from "${PROPAGATE_FROM_INPUT}" \
    --propagation-steps <%= Shellwords.escape(context.propagation_steps.to_s) %> \
    --lag-ns <%= Shellwords.escape(context.lag_ns.to_s) %> \
    --weights-precision "${WEIGHTS_PRECISION}" \
    "${ALLOW_DOWNLOAD[@]}"

# Build the report inside the same pinned container: the host python3 may be
# older than the 3.7 the report module requires (the compute nodes' default
# python3 is 3.6, which rejects `from __future__ import annotations` -- found by
# the first GPU smoke run), while the container carries the pinned 3.12.
apptainer exec --cleanenv \
  --bind "${OOD_SESSION_DIR}:${OOD_SESSION_DIR}:ro" \
  --bind "${OUT_DIR}:${OUT_DIR}" \
  "${BIOEMU2_IMAGE}" \
  python "${OOD_SESSION_DIR}/build_report.py" "${OUT_DIR}"
printf '%s\n' "${RUN_ID}" > "${OOD_SESSION_DIR}/run_dir.txt"
ln -sfn "${OUT_DIR}" "${OOD_SESSION_DIR}/results"
echo "BioEmu2 completed successfully: ${OUT_DIR}/report.html"
